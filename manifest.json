{
  "manifest_version": 3,
  "name": "Roblox CSV Exporter",
  "version": "1.1",
  "permissions": ["tabs", "scripting", "downloads", "storage"],
  "host_permissions": ["https://create.roblox.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
